{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure MTS2D for clangd",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "release"],
            "options": {
                "cwd": "${workspaceFolder}/MTS2D"
            }
        },
        {
            "label": "Build managed simulator",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "MTS_Management",
                "--sites",
                "${workspaceFolder}/MTSManager/sites.toml",
                "build",
                "--site",
                "local"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Plot benchmark",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${workspaceFolder}/MTSPlot/examples/benchmark_figures.py"
            ],
            "options": {
                "env": {
                    "MPLBACKEND": "Agg"
                }
            }
        }
    ]
}
